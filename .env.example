# Copy this file to .env and change the values. NEVER commit .env (it must be in .gitignore).
# Use only letters, digits and underscores in passwords: special characters must be
# URL-encoded when they are placed inside connection strings.

# =============================================================================
# 1. Infrastructure credentials (read by docker-compose AND by the application)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=docforge
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=docforge

# --- Object storage (S3-compatible) ---
S3_ACCESS_KEY=docforge_access
S3_SECRET_KEY=change_me_s3_secret_key
S3_BUCKET=docforge-files

# --- RabbitMQ ---
RABBITMQ_USER=docforge
RABBITMQ_PASSWORD=change_me_rabbitmq

# =============================================================================
# 2. Connection settings (read by the application, not by compose)
#    Keep the passwords identical to the ones above.
# =============================================================================

# Two S3 endpoints on purpose: a presigned URL is signed for one hostname. If the API
# signs for the internal name but the client uses localhost, the signature fails.
# When the API runs on your host (not inside compose), the internal endpoint is localhost too.
S3_ENDPOINT_INTERNAL=http://localhost:8333
S3_ENDPOINT_PUBLIC=http://localhost:8333

DATABASE_URL=postgresql+psycopg://docforge:change_me_postgres@localhost:5432/docforge
CELERY_BROKER_URL=amqp://docforge:change_me_rabbitmq@localhost:5672/docforge
QDRANT_URL=http://localhost:6333

# Redis used for per-tenant limits (Tenant Fairness).
# Start it with:  docker compose --profile scale up -d redis-state
# Match the host port published in docker-compose.yml.
REDIS_STATE_URL=redis://localhost:6379/0

# =============================================================================
# 3. Optional image overrides: pin exact versions after the first successful run
# =============================================================================
# POSTGRES_IMAGE=postgres:17-alpine
# OBJECTSTORE_IMAGE=chrislusf/seaweedfs:latest
# RABBITMQ_IMAGE=rabbitmq:3.13-management-alpine
# QDRANT_IMAGE=qdrant/qdrant:v1.15.0
# REDIS_IMAGE=redis:7-alpine

# =============================================================================
# 4. Tuning knobs (read by the application, not by compose)
#    Rule (D12): every limit is configuration. Changing these never needs a code change.
#    Everything below is optional: the value shown is the default in app/core/config.py
#    where the default is known, otherwise a sensible example.
# =============================================================================

# --- Files and size classes ---
# SIZE_CLASS_SMALL_MAX_MB=25          # files above this go to the large queue
# MAX_FILE_MB=200                     # hard upload cap

# --- Queue ---
# QUEUE_TYPE=quorum                   # quorum, or classic as a fallback
# QUEUE_DELIVERY_LIMIT=5              # redeliveries before a message is dead-lettered (quorum only)

# --- Pipeline ---
# CHUNKER_VERSION=v1                  # bump it to re-chunk; old points are removed after success
# CHUNK_CHARS=1000
# CHUNK_OVERLAP_CHARS=100             # must be smaller than half of CHUNK_CHARS
# EMBED_LATENCY_S=0.05                # FakeEmbedder: simulated latency per batch
# EMBED_ERROR_RATE=0.0                # FakeEmbedder: probability of a transient failure (0 to 1)

# --- Reliability: retry, timeouts ---
# MAX_ATTEMPTS=5                      # total attempts per file, the first one included
# RETRY_BASE_S=10                     # backoff ceiling doubles from this value...
# RETRY_CAP_S=300                     # ...up to this value (full jitter on top)
# TASK_SOFT_TIME_LIMIT_S=600          # must be smaller than the hard limit
# TASK_HARD_TIME_LIMIT_S=900

# --- Maintenance: reconciler, janitor ---
# RECONCILE_INTERVAL_S=30             # also the minimum delay of a retry
# MAINTENANCE_BATCH=200               # files per rule per cycle
# STUCK_UPLOADED_S=120
# STUCK_QUEUED_S=900
# STUCK_PROCESSING_S=1200             # must be larger than TASK_HARD_TIME_LIMIT_S
# PENDING_UPLOAD_TTL_S=86400          # abandoned uploads are removed after this
# ORPHAN_GRACE_S=3600                 # the orphan audit ignores objects younger than this

# --- Lifecycle (D5) ---
# RETENTION_ORIGINALS_DAYS=7          # originals of READY files
# RETENTION_FAILED_DAYS=30            # originals of FAILED files

# --- Tenant fairness ---
# TENANT_RATE_PER_S=10                # new uploads per second per tenant (429 above it)
# TENANT_MAX_BACKLOG=500              # UPLOADED + QUEUED + PROCESSING files per tenant (429 above it)
# TENANT_MAX_CONCURRENT=4             # files of one tenant processed at the same time
# TENANT_DEFER_S=15                   # base wait when a tenant is at its concurrency cap
# TENANT_RETRY_AFTER_S=30             # Retry-After header for a full backlog
# RECONCILE_PER_TENANT_BATCH=20       # files per tenant published per reconcile cycle

# =============================================================================
# 5. Quick lab profile: faster feedback for the experiments in the README.
#    Uncomment these (and comment the defaults above) while experimenting.
# =============================================================================
# TASK_SOFT_TIME_LIMIT_S=20
# TASK_HARD_TIME_LIMIT_S=30
# STUCK_PROCESSING_S=60
# RECONCILE_INTERVAL_S=10
# EMBED_LATENCY_S=3
# TENANT_MAX_CONCURRENT=2
